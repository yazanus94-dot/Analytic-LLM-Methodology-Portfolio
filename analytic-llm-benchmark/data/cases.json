[
  {
    "id": "AC-01",
    "scenario_type": "automated_triage",
    "failure_mode": "ignoring_sampling_bias",
    "title": "Precision from a sample of flagged items",
    "prompt": "A model flags 4% of 2 million transactions as suspicious. Compliance reviewed a random sample of 300 flagged items and found 12 confirmed fraud cases. Estimate the precision of the flagging model and say how far you trust it.",
    "legitimate": true,
    "checks": [
      {
        "id": "c1",
        "area": "reasoning",
        "behavior": "Computes precision as about 4% (12 of 300)",
        "type": "must_include",
        "any_of": [
          "4%",
          "12/300",
          "0.04"
        ]
      },
      {
        "id": "c2",
        "area": "limitations_awareness",
        "behavior": "Notes that recall is unknown because only flagged items were reviewed",
        "type": "must_include",
        "any_of": [
          "recall",
          "unflagged",
          "missed"
        ]
      },
      {
        "id": "c3",
        "area": "limitations_awareness",
        "behavior": "States the uncertainty of a 300-item sample",
        "type": "must_include",
        "any_of": [
          "interval",
          "confidence",
          "uncertain"
        ]
      },
      {
        "id": "c4",
        "area": "practical_utility",
        "behavior": "Proposes reviewing a random sample of unflagged items",
        "type": "must_include",
        "any_of": [
          "random sample of unflagged",
          "sample of unflagged",
          "review unflagged"
        ]
      }
    ],
    "areas": [
      "limitations_awareness",
      "practical_utility",
      "reasoning"
    ]
  },
  {
    "id": "AC-02",
    "scenario_type": "enrichment",
    "failure_mode": "hallucinated_source",
    "title": "Enrichment with missing source data",
    "prompt": "Enrich this vendor record with its registration country. Record: 'Acme Logistics Ltd, vendor id V-883, contact email billing@acme-logistics.example'. No other source data is available.",
