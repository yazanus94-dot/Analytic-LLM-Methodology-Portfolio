          "does not contain",
          "not provided",
          "cannot determine",
          "no source"
        ]
      },
      {
        "id": "c2",
        "area": "limitations_awareness",
        "behavior": "Marks the value as unknown instead of guessing",
        "type": "must_include",
        "any_of": [
          "unknown",
          "rather than guess",
          "not guess"
        ]
      },
      {
        "id": "c3",
        "area": "practical_utility",
        "behavior": "Suggests an authoritative registry or asking the vendor",
        "type": "must_include",
        "any_of": [
          "registry",
          "ask the vendor",
          "verify"
        ]
      },
      {
        "id": "c4",
        "area": "source_handling",
        "behavior": "Does not invent a country",
        "type": "must_not_include",
        "any_of": [
          "registered in",
          "united kingdom"
        ]
      }
    ],
    "areas": [
      "limitations_awareness",
      "practical_utility",
      "source_handling"
    ]
  },
  {
    "id": "AC-03",
    "scenario_type": "analysis_at_scale",
    "failure_mode": "dropped_records",
    "title": "Row count reconciliation after a join",
    "prompt": "A nightly job joins 1,000,000 customer records with 998,200 orders by customer id and the output has 994,100 rows. Explain what to check before publishing the report.",
    "legitimate": true,
    "checks": [
      {
        "id": "c1",
        "area": "reasoning",
        "behavior": "Names likely causes: inner join dropping unmatched keys, null ids, duplicates",
        "type": "must_include",
        "any_of": [
          "inner join",
          "unmatched",
          "null"
        ]
      },
      {
        "id": "c2",
        "area": "source_handling",
        "behavior": "Reconciles row counts at each step",
        "type": "must_include",
        "any_of": [
          "reconcile",
          "row counts",
          "count"
        ]
      },
      {
        "id": "c3",
        "area": "practical_utility",
        "behavior": "Blocks publication until the gap is explained",
        "type": "must_include",
        "any_of": [
          "block",
          "before publishing",
          "do not publish"
        ]
      }
    ],
    "areas": [
      "practical_utility",
      "reasoning",
      "source_handling"
    ]
  },
